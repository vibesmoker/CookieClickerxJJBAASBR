\ No newline at end of file
+                         text='XFBIN Model Container (.xfbin)')
+
+def simple_material(meshmat, xfbin_mat, name):
+    """Flat textured material (Blender 4.x safe): diffuse texture -> Principled base color + alpha."""
+    mat = bpy.data.materials.new(name)
+    mat.use_nodes = True
+    nt = mat.node_tree
+    bsdf = nt.nodes.get('Principled BSDF')
+    tex = nt.nodes.new('ShaderNodeTexImage')
+    img = None
+    if xfbin_mat.texture_groups and xfbin_mat.texture_groups[0].texture_chunks:
+        img = bpy.data.images.get(f'{xfbin_mat.texture_groups[0].texture_chunks[0].name}_0')
+    tex.image = img
+    tex.interpolation = 'Linear'
+    nt.links.new(tex.outputs['Color'], bsdf.inputs['Base Color'])
+    if meshmat.sourceFactor in (1, 2, 5):
+        nt.links.new(tex.outputs['Alpha'], bsdf.inputs['Alpha'])
+    mat['jj_alpha'] = meshmat.sourceFactor
+    mat['jj_cull'] = meshmat.cullMode
+    nt.nodes.active = tex
+    return mat
